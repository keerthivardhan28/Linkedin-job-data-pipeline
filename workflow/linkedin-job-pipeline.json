    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $json;\nconst text = (job.descriptionHtml || \"\").replace(/<[^>]*>/g, \" \");\n\n// Experience\nconst exp = text.match(/(\\d+\\s*[-–]\\s*\\d+\\s*years?|\\d+\\+\\s*years?|\\d+\\s*years?|freshers?)/i);\n\n// Salary\nconst salary = text.match(/(₹|Rs\\.?)\\s?[\\d,]+(?:\\s*-\\s*(₹|Rs\\.?)?\\s?[\\d,]+)?/i);\n\n// Work Mode\nconst mode = text.match(/Remote|Hybrid|Onsite|Work from Home|WFH/i);\n\n// Job Type\nconst type = text.match(/Full[- ]?Time|Part[- ]?Time|Internship|Contract|Temporary/i);\n\njob.experience = exp ? exp[0] : \"Not Mentioned\";\njob.salary = salary ? salary[0] : \"Not Mentioned\";\njob.workMode = mode ? mode[0] : \"Not Mentioned\";\njob.jobType = type ? type[0] : \"Not Mentioned\";\n\nreturn {\n  json: job\n};"
      },
